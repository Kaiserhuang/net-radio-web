[Unit]
Description=Net Radio Web App
After=network.target

[Service]
Type=simple
User=netradio
Group=netradio
WorkingDirectory=/opt/net-radio
ExecStart=/opt/net-radio/venv/bin/python server.py
Restart=always
RestartSec=5
Environment=HOST=127.0.0.1
Environment=PORT=8000
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
